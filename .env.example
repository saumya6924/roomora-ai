# Copy to backend/.env for local work. In production these are set in Railway.
# Never commit real values.

ENVIRONMENT=development                # development | production
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Postgres connection string (Project settings > Database > Connection string, session pooler).
# Leave unset locally to use a throwaway SQLite file.
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Supabase Storage (server-side only; the service key must never reach the browser).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PUBLIC_BUCKET=public-media
PRIVATE_BUCKET=room-photos

# Text AI editor: without a key the built-in rules engine is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Room photo studio: auto | cloudflare | mock
IMAGE_PROVIDER=auto
CF_ACCOUNT_ID=
CF_API_TOKEN=
STUDIO_DAILY_LIMIT=20
